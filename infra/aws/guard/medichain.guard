# MediChain's own deployment rules for cfn-guard (infra/aws/medichain.yaml).
#
#   cfn-guard validate -d infra/aws/medichain.yaml -r infra/aws/guard/medichain.guard
#
# These are the stack's hard requirements, written as checks so a later edit
# cannot quietly drop one.

let buckets = Resources.*[ Type == 'AWS::S3::Bucket' ]
let bucket_policies = Resources.*[ Type == 'AWS::S3::BucketPolicy' ]
let templates = Resources.*[ Type == 'AWS::EC2::LaunchTemplate' ]
let groups = Resources.*[ Type == 'AWS::EC2::SecurityGroup' ]
let repositories = Resources.*[ Type == 'AWS::ECR::Repository' ]

# Every bucket is private and encrypted.
rule buckets_private_and_encrypted when %buckets !empty {
    %buckets.Properties.PublicAccessBlockConfiguration.BlockPublicAcls == true
    %buckets.Properties.PublicAccessBlockConfiguration.BlockPublicPolicy == true
    %buckets.Properties.PublicAccessBlockConfiguration.IgnorePublicAcls == true
    %buckets.Properties.PublicAccessBlockConfiguration.RestrictPublicBuckets == true
    %buckets.Properties.BucketEncryption.ServerSideEncryptionConfiguration[*].ServerSideEncryptionByDefault.SSEAlgorithm IN ['AES256', 'aws:kms']
    %buckets.Properties.VersioningConfiguration.Status == 'Enabled'
}

# Every bucket policy refuses plain HTTP.
rule bucket_policies_require_tls when %bucket_policies !empty {
    some %bucket_policies.Properties.PolicyDocument.Statement[*] {
        Effect == 'Deny'
        Condition.Bool.'aws:SecureTransport' == 'false'
    }
}

# The audit checkpoint bucket is write-once.
rule audit_bucket_object_lock when %buckets !empty {
    some %buckets.Properties.ObjectLockEnabled == true
    some %buckets.Properties.ObjectLockConfiguration.Rule.DefaultRetention.Mode exists
}

# Instances: IMDSv2 only, encrypted root volume.
rule instances_imdsv2_and_encrypted when %templates !empty {
    %templates.Properties.LaunchTemplateData.MetadataOptions.HttpTokens == 'required'
    %templates.Properties.LaunchTemplateData.BlockDeviceMappings[*].Ebs.Encrypted == true
}

# No SSH, RDP or database port is reachable from anywhere.
rule no_admin_or_database_ports when %groups !empty {
    %groups.Properties.SecurityGroupIngress[*] {
        FromPort NOT IN [22, 3389, 5432, 5050]
    }
}

# Images are scanned and cannot be overwritten under an existing tag.
rule repositories_scanned_and_immutable when %repositories !empty {
    %repositories.Properties.ImageTagMutability == 'IMMUTABLE'
    %repositories.Properties.ImageScanningConfiguration.ScanOnPush == true
}
